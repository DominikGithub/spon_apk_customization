# ---------------------------------------------------------------------------
# Everything ignored here is regenerated by REBUILD_PROMPT.md. Only the prompt,
# the patch scripts and their config files need to be versioned.
# ---------------------------------------------------------------------------

# APKs: inputs and outputs. spon.apk comes from `adb pull` off the phone, the
# rest are build artefacts. All binary, all reproducible, and all SPIEGEL's
# copyrighted code - it does not belong in a repo.
*.apk
*.idsig
signed/

# Working trees, rebuilt from spon.apk every time (~176 MB and ~72 MB).
apktool_out/
jadx_out/
jadx.log

# Raw unzip of the APK; keep only the hand-written overview.
extracted_apk/*
!extracted_apk/README.md

# Toolchain lives in ~/.local/opt/apktools, but guard against a local copy.
apktools/

# Local machine noise.
__pycache__/
*.pyc
.DS_Store
*.swp

# Claude Code local settings (machine-specific permission allowlist).
.claude/settings.local.json
Android_list_aps.md
